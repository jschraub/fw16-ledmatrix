# matrixd — LED matrix status daemon for the Framework Laptop 16.
#
# A *user* unit, not a system one. Everything the daemon reads is per-user:
# the Claude OAuth token in ~/.claude, the session snapshots under
# $XDG_RUNTIME_DIR, and device access granted by the uaccess ACL to whoever
# holds the active seat. A system unit would have to be handed all of that
# explicitly, and would then be running as root to read one user's files.
#
# Installed by install.sh, which substitutes @INSTALL_DIR@ for the checkout it
# was run from. Edit it there, not in ~/.config/systemd/user.

[Unit]
Description=Framework 16 LED matrix status daemon
Documentation=https://github.com/jschraub/fw16-ledmatrix

# Deliberately not tied to graphical-session.target. This daemon needs no
# Wayland connection — brightness and DPMS come from sysfs, volume from
# pactl — so binding it to a compositor's lifecycle would buy nothing and
# cost the usual per-compositor unit plumbing.

[Service]
Type=exec
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/env python3 -m matrixd

# Without this the journal labels every line `env[1234]`, because that is what
# ExecStart literally runs. `env` is here so the unit does not hardcode a
# python path that differs on every distribution.
SyslogIdentifier=matrixd

# Not Restart=always: a clean exit means it was told to stop.
Restart=on-failure
RestartSec=5s

# SIGTERM is handled — the loop breaks before painting and puts both panels to
# sleep, measured at 22ms. The generous timeout is for the pathological case
# where a greyscale frame is still draining behind the Sleep command.
TimeoutStopSec=10s

# Starting before the seat session goes active is normal and not a failure:
# the uaccess ACL is not applied yet, so the first open of each panel is
# EACCES and the daemon retries on its own every few seconds.

# Modest hardening only. The daemon reads ~/.claude, /sys, and two tty
# devices, and forks pactl; a ProtectHome or DeviceAllow policy tight enough
# to be worth having would break one of those on the next machine.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
